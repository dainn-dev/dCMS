    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>dCMS.Notification.Worker</RootNamespace>
    <UserSecretsId>dCMS-Notification-Worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
