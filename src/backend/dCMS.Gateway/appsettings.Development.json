{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Information"
    }
  },
  "Auth": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "returns-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/gateway/v1/returns/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/returns/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      }
      ,
      "reports-route": {
        "ClusterId": "reports-cluster",
        "Match": { "Path": "/gateway/v1/reports/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/reports/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/gateway/v1/notifications/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5001" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5003" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5002" }
        }
      },
      "promotions-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5005" }
        }
      },
      "fulfillment-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5006" }
        }
      },
      "reports-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5007" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5008" }
        }
      },
      "vouchers-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5010" }
        }
      },
      "loyalty-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5011" }
        }
      }
    }
  }
}
