        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "loyalty-holds-route": {
        "ClusterId": "loyalty-cluster",
        "Match": { "Path": "/gateway/v1/loyalty-holds/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/gateway/v1/identity/{**catch-all}" },
        "Transforms": [
