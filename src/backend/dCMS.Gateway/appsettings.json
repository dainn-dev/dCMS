          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "storefront-orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/storefront/v1/orders/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "storefront-order-cart-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/storefront/v1/cart/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/cart/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "storefront-checkout-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/storefront/v1/checkout" },
        "Transforms": [
          { "PathPattern": "/api/v1/checkout" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "storefront-catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/storefront/v1/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "default": { "Address": "http://catalog-api:8080" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "default": { "Address": "http://order-api:8080" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "default": { "Address": "http://inventory-api:8080" }
        }
      },
      "promotions-cluster": {
        "Destinations": {
          "default": { "Address": "http://promotions-api:8080" }
        }
      },
      "fulfillment-cluster": {
        "Destinations": {
          "default": { "Address": "http://fulfillment-api:8080" }
        }
      },
      "reports-cluster": {
        "Destinations": {
          "default": { "Address": "http://reports-api:8080" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "default": { "Address": "http://notification-api:8080" }
        }
      },
      "approvals-cluster": {
        "Destinations": {
          "default": { "Address": "http://approval-api:8080" }
        }
      },
      "vouchers-cluster": {
        "Destinations": {
          "default": { "Address": "http://voucher-api:8080" }
        }
      },
      "loyalty-cluster": {
        "Destinations": {
          "default": { "Address": "http://loyalty-api:8080" }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "default": { "Address": "http://identity-api:8080" }
        }
      }
    }
  }
}
