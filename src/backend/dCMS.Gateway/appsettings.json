{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Auth": {
    "Enabled": true,
    "JwtSigningKey": "",
    "Issuer": "dcms-gateway",
    "Audience": "dcms-services",
    "InternalTokenTtlSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 500,
    "WindowSeconds": 60
  },
  "HostRouting": {
    "Enabled": true,
    "FailClosedOnStorefront": true,
    "PlatformHosts": [ "localhost", "127.0.0.1" ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/gateway/v1/catalog/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/gateway/v1/orders/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "returns-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/gateway/v1/returns/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/returns/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/gateway/v1/inventory/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "promotions-route": {
        "ClusterId": "promotions-cluster",
        "Match": { "Path": "/gateway/v1/promotions/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "fulfillment-route": {
        "ClusterId": "fulfillment-cluster",
        "Match": { "Path": "/gateway/v1/fulfillment/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "reports-route": {
        "ClusterId": "reports-cluster",
        "Match": { "Path": "/gateway/v1/reports/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/reports/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/gateway/v1/notifications/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "approvals-route": {
        "ClusterId": "approvals-cluster",
        "Match": { "Path": "/gateway/v1/approvals/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "vouchers-route": {
        "ClusterId": "vouchers-cluster",
        "Match": { "Path": "/gateway/v1/vouchers/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" },
          { "RequestHeader": "X-Forwarded-By", "Set": "dcms-gateway" }
        ]
      },
      "voucher-holds-route": {
        "ClusterId": "vouchers-cluster",
