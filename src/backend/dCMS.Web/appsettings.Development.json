{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      },
      "DeliveryApi": {
        "PublicAccess": true
      }
    }
  },
  "ConnectionStrings": {
    "Catalog": "Host=127.0.0.1;Port=5432;Database=dcms_catalog;Username=dcms;Password=Your_password123",
    "Order": "Host=127.0.0.1;Port=5432;Database=dcms_order;Username=dcms;Password=Your_password123"
  },
  "Dcms": {
    "GatewayUrl": "http://localhost:5100",
    "Auth": {
      "Enabled": true,
      "JwtSigningKey": "dcms-local-dev-signing-key-min-32-chars!!",
      "Issuer": "dcms-gateway",
      "Audience": "dcms-services",
      "TokenTtlSeconds": 3600
    },
    "Estore": {
      "TenantId": "t1",
      "StoreId": "s1"
    }
  }
  ,
  "uSync": {
    "Settings": {
      "ExportAtStartup": "All"
    }
  }
}
