{
  "$schema": "../../umbraco-package-schema.json",
  "name": "dCMS Backoffice",
  "version": "2.0.0",
  "allowPackageTelemetry": false,
  "extensions": [
    {
      "type": "backofficeEntryPoint",
      "alias": "Dcms.Backoffice.HideGettingStarted",
      "name": "dCMS — hide Getting Started & Packages",
      "js": "/App_Plugins/DcmsV16/dcms-hide-getting-started.js"
    },
    {
      "type": "section",
      "alias": "dcmsOrders",
      "name": "Orders",
      "weight": 950,
      "element": "/App_Plugins/DcmsV16/dcms-orders-section.js",
      "meta": {
        "label": "Orders",
        "pathname": "dcms-orders"
      }
    },
    {
      "type": "section",
      "alias": "dcmsEStore",
      "name": "eStore",
      "weight": 960,
      "element": "/App_Plugins/DcmsV16/dcms-estore-section.js",
      "meta": {
        "label": "eStore",
        "pathname": "dcms-estore"
      }
    },
    {
      "type": "dashboard",
      "alias": "Dcms.Dashboard.SalesOverview",
      "name": "Dashboard",
      "element": "/App_Plugins/DcmsV16/dcms-dashboard.js",
      "weight": 12,
      "meta": {
        "label": "Dashboard",
        "pathname": "dcms-dashboard"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    }
  ]
}
