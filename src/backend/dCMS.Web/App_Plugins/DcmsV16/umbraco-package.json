{
  "$schema": "../../umbraco-package-schema.json",
  "name": "dCMS Backoffice",
  "version": "2.0.0",
  "allowPackageTelemetry": false,
  "extensions": [
    {
      "type": "backofficeEntryPoint",
      "alias": "Dcms.Backoffice.HideGettingStarted",
      "name": "dCMS — hide Getting Started & Packages",
      "js": "/App_Plugins/DcmsV16/dcms-hide-getting-started.js"
    },
    {
      "type": "propertyEditorUi",
      "alias": "Dainn.CustomFontPicker",
      "name": "Dainn Custom Font Picker",
      "element": "/App_Plugins/DcmsV16/dcms-font-picker-property-editor.js",
      "elementName": "dcms-font-picker-property-editor",
      "meta": {
        "label": "Dainn Custom Font Picker",
        "icon": "icon-autofill",
        "group": "common",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "Dainn.ColorPalette",
      "name": "Dainn Color Palette",
      "element": "/App_Plugins/DcmsV16/dcms-color-palette-property-editor.js",
      "elementName": "dcms-color-palette-property-editor",
      "meta": {
        "label": "Dainn Color Palette",
        "icon": "icon-colorpicker",
        "group": "common",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "Dainn.CustomColorPicker",
      "name": "Dainn Custom Color Picker",
      "element": "/App_Plugins/DcmsV16/dcms-color-picker-property-editor.js",
      "elementName": "dcms-color-picker-property-editor",
      "meta": {
        "label": "Dainn Custom Color Picker",
        "icon": "icon-colorpicker",
        "group": "common",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String",
        "settings": {
          "properties": [
            {
              "alias": "defaultColor",
              "label": "Default Color",
              "description": "Màu mặc định khi chưa có giá trị (hex 8 ký tự, ví dụ: #2986ccff). Để trống sẽ dùng màu hệ thống.",
              "propertyEditorUiAlias": "Umb.PropertyEditorUi.TextBox"
            }
          ]
        }
      }
    },
    {
      "type": "headerApp",
      "alias": "Dcms.HeaderApp.Notifications",
      "name": "Notifications",
      "kind": "button",
      "weight": 100,
      "meta": {
        "label": "Notifications",
        "icon": "icon-bell",
        "href": "#"
      }
    },
    {
      "type": "section",
      "alias": "dcmsEStore",
      "name": "eStore",
      "weight": 960,
      "element": "/App_Plugins/DcmsV16/dcms-estore-section.js",
      "meta": {
        "label": "eStore",
        "pathname": "dcms-estore"
      }
    },
    {
      "type": "section",
      "alias": "dcmsOrders",
      "name": "Orders",
      "weight": 959,
      "element": "/App_Plugins/DcmsV16/dcms-orders-section.js",
      "meta": {
        "label": "Orders",
        "pathname": "dcms-orders"
      }
    },
    {
      "type": "section",
      "alias": "dcmsApproval",
      "name": "Approval",
      "weight": 958,
      "element": "/App_Plugins/DcmsV16/dcms-approval-section.js",
      "meta": {
        "label": "Approval",
        "pathname": "dcms-approval"
      }
    },
    {
      "type": "section",
      "alias": "dcmsReports",
      "name": "Reports",
      "weight": 957,
      "element": "/App_Plugins/DcmsV16/dcms-reports-section.js",
      "meta": {
        "label": "Reports",
        "pathname": "dcms-reports"
      }
    },
    {
      "type": "section",
      "alias": "dcmsAccess",
      "name": "Access",
      "weight": 956,
      "element": "/App_Plugins/DcmsV16/dcms-access-section.js",
      "meta": {
        "label": "Access",
        "pathname": "dcms-access"
      }
    },
    {
      "type": "dashboard",
      "alias": "Dcms.Dashboard.SalesOverview",
      "name": "Dashboard",
      "element": "/App_Plugins/DcmsV16/dcms-dashboard.js",
      "weight": 12,
      "meta": {
        "label": "Dashboard",
        "pathname": "dcms-dashboard"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    }
  ]
}
