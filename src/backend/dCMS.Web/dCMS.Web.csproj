<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco brings Microsoft.Data.SqlClient. appsettings uses localhost:14333 (compose SQL Server publish); in-container compose sets Server=sqlserver,1433. -->
    <PackageReference Include="Umbraco.Cms" Version="16.5.1" />
  </ItemGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-54mj-vcvj-q3v5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="App_Plugins\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="config\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ── Frontend SPA build ──────────────────────────────────────────────── -->
  <PropertyGroup>
    <!-- Cross-platform: use $/ which MSBuild resolves to OS directory separator -->
    <SpaDir Condition="'$(SpaDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../backoffice/dcms-backoffice-spa'))</SpaDir>
    <!-- Set SkipFrontendBuild=true on the CLI to skip: dotnet run /p:SkipFrontendBuild=true -->
    <SkipFrontendBuild Condition="'$(SkipFrontendBuild)' == ''">false</SkipFrontendBuild>
  </PropertyGroup>

  <Target Name="BuildFrontendSpa" BeforeTargets="BeforeBuild" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Text="[dCMS] Building backoffice SPA from $(SpaDir)..." Importance="high" />
    <!-- Install deps only when node_modules is missing -->
    <Exec Command="npm install --prefer-offline --no-audit --no-fund"
          WorkingDirectory="$(SpaDir)"
          Condition="!Exists('$(SpaDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaDir)" />
    <!-- npm run build already invokes build:orders + build:estore + build:dashboard via the top-level "build" script -->

    <Message Text="[dCMS] SPA build done — dist copied via CopyToOutputDirectory." Importance="high" />
  </Target>
  <!-- ──────────────────────────────────────────────────────────────────────── -->

</Project>
