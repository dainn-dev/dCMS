# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/backend/dCMS.Messaging.Contracts/dCMS.Messaging.Contracts.csproj dCMS.Messaging.Contracts/
COPY src/backend/dCMS.Common/dCMS.Common.csproj dCMS.Common/
COPY src/backend/dCMS.Billing.Domain/dCMS.Billing.Domain.csproj dCMS.Billing.Domain/
COPY src/backend/dCMS.Provisioning.Domain/dCMS.Provisioning.Domain.csproj dCMS.Provisioning.Domain/
COPY src/backend/dCMS.Catalog.Domain/dCMS.Catalog.Domain.csproj dCMS.Catalog.Domain/
COPY src/backend/dCMS.Promotions.Domain/dCMS.Promotions.Domain.csproj dCMS.Promotions.Domain/
COPY src/backend/dCMS.Fulfillment.Domain/dCMS.Fulfillment.Domain.csproj dCMS.Fulfillment.Domain/
COPY src/backend/dCMS.Approvals.Domain/dCMS.Approvals.Domain.csproj dCMS.Approvals.Domain/
COPY src/backend/dCMS.Imports.Domain/dCMS.Imports.Domain.csproj dCMS.Imports.Domain/
COPY src/backend/dCMS.Infrastructure/dCMS.Infrastructure.csproj dCMS.Infrastructure/
COPY src/backend/dCMS.Catalog.Worker/dCMS.Catalog.Worker.csproj dCMS.Catalog.Worker/
RUN dotnet restore dCMS.Catalog.Worker/dCMS.Catalog.Worker.csproj

COPY src/backend/ ./
RUN dotnet restore dCMS.Catalog.Worker/dCMS.Catalog.Worker.csproj \
    && dotnet publish dCMS.Catalog.Worker/dCMS.Catalog.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "dCMS.Catalog.Worker.dll"]
