FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/backend ./src/backend
WORKDIR /src/src/backend

RUN dotnet restore dCMS.Identity.Api/dCMS.Identity.Api.csproj
RUN dotnet publish dCMS.Identity.Api/dCMS.Identity.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish ./
ENTRYPOINT ["dotnet", "dCMS.Identity.Api.dll"]
