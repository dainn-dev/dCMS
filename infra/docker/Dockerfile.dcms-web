# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# ── Install Node.js (for SPA build) ──────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Restore .NET deps ─────────────────────────────────────────────────────────
COPY src/backend/dCMS.Messaging.Contracts/dCMS.Messaging.Contracts.csproj dCMS.Messaging.Contracts/
COPY src/backend/dCMS.Common/dCMS.Common.csproj dCMS.Common/
COPY src/backend/dCMS.Catalog.Domain/dCMS.Catalog.Domain.csproj dCMS.Catalog.Domain/
COPY src/backend/dCMS.Promotions.Domain/dCMS.Promotions.Domain.csproj dCMS.Promotions.Domain/
COPY src/backend/dCMS.Fulfillment.Domain/dCMS.Fulfillment.Domain.csproj dCMS.Fulfillment.Domain/
COPY src/backend/dCMS.Approvals.Domain/dCMS.Approvals.Domain.csproj dCMS.Approvals.Domain/
COPY src/backend/dCMS.Imports.Domain/dCMS.Imports.Domain.csproj dCMS.Imports.Domain/
COPY src/backend/dCMS.AspNetCore.Auth/dCMS.AspNetCore.Auth.csproj dCMS.AspNetCore.Auth/
COPY src/backend/dCMS.Infrastructure/dCMS.Infrastructure.csproj dCMS.Infrastructure/
COPY src/backend/dCMS.Web/dCMS.Web.csproj dCMS.Web/
RUN dotnet restore dCMS.Web/dCMS.Web.csproj

# ── Copy SPA source + install npm deps ───────────────────────────────────────
COPY src/backoffice/dcms-backoffice-spa/package*.json /spa/
RUN cd /spa && npm install --prefer-offline --no-audit --no-fund

COPY src/backoffice/dcms-backoffice-spa/ /spa/

# ── Copy backend source + build ───────────────────────────────────────────────
COPY src/backend/dCMS.Messaging.Contracts/ ./dCMS.Messaging.Contracts/
COPY src/backend/dCMS.Common/ ./dCMS.Common/
COPY src/backend/dCMS.Catalog.Domain/ ./dCMS.Catalog.Domain/
COPY src/backend/dCMS.Promotions.Domain/ ./dCMS.Promotions.Domain/
COPY src/backend/dCMS.Fulfillment.Domain/ ./dCMS.Fulfillment.Domain/
COPY src/backend/dCMS.Approvals.Domain/ ./dCMS.Approvals.Domain/
COPY src/backend/dCMS.Imports.Domain/ ./dCMS.Imports.Domain/
COPY src/backend/dCMS.AspNetCore.Auth/ ./dCMS.AspNetCore.Auth/
COPY src/backend/dCMS.Infrastructure/ ./dCMS.Infrastructure/
COPY src/backend/dCMS.Web/ ./dCMS.Web/

WORKDIR /src/dCMS.Web

# Override SpaDir to point to where we copied the SPA
RUN dotnet publish dCMS.Web.csproj -c Release -o /app --no-restore \
    /p:SpaDir=/spa

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "dCMS.Web.dll"]
