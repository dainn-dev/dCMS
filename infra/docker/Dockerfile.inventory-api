# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/backend/dCMS.Messaging.Contracts/dCMS.Messaging.Contracts.csproj dCMS.Messaging.Contracts/
COPY src/backend/dCMS.Common/dCMS.Common.csproj dCMS.Common/
COPY src/backend/dCMS.Catalog.Domain/dCMS.Catalog.Domain.csproj dCMS.Catalog.Domain/
COPY src/backend/dCMS.Promotions.Domain/dCMS.Promotions.Domain.csproj dCMS.Promotions.Domain/
COPY src/backend/dCMS.Fulfillment.Domain/dCMS.Fulfillment.Domain.csproj dCMS.Fulfillment.Domain/
COPY src/backend/dCMS.Approvals.Domain/dCMS.Approvals.Domain.csproj dCMS.Approvals.Domain/
COPY src/backend/dCMS.Imports.Domain/dCMS.Imports.Domain.csproj dCMS.Imports.Domain/
COPY src/backend/dCMS.Inventory.Core/dCMS.Inventory.Core.csproj dCMS.Inventory.Core/
COPY src/backend/dCMS.AspNetCore.Auth/dCMS.AspNetCore.Auth.csproj dCMS.AspNetCore.Auth/
COPY src/backend/dCMS.Inventory.Infrastructure/dCMS.Inventory.Infrastructure.csproj dCMS.Inventory.Infrastructure/
COPY src/backend/dCMS.Inventory.Api/dCMS.Inventory.Api.csproj dCMS.Inventory.Api/
RUN dotnet restore dCMS.Inventory.Api/dCMS.Inventory.Api.csproj

COPY src/backend/ ./
RUN dotnet restore dCMS.Inventory.Api/dCMS.Inventory.Api.csproj \
    && dotnet publish dCMS.Inventory.Api/dCMS.Inventory.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "dCMS.Inventory.Api.dll"]
